# --- Base de datos (PostgreSQL local en Docker) ---
POSTGRES_DB=smartdesk
POSTGRES_USER=smartdesk
POSTGRES_PASSWORD=change_me_locally
POSTGRES_PORT=5432

# --- Seguridad ---
JWT_SECRET=replace_with_a_long_random_local_secret
JWT_EXPIRATION_MINUTES=60

# --- Gemini (opcional: sin API key se usan reglas locales) ---
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_OUTPUT_TOKENS=500
AUTOMATION_ESCALATION_INTERVAL_MS=60000

# --- Modo demostración (permitir marcar incidencias como vencidas desde /api/v1/demo) ---
DEMO_MODE_ENABLED=false

# --- Puertos y orígenes permitidos ---
BACKEND_PORT=8080
FRONTEND_PORT=4200
CORS_ALLOWED_ORIGINS=http://localhost:4200
